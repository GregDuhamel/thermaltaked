# Starts with the graphical session rather than with the user manager: before
# it, the panel's hidraw nodes still belong to root, logind has no session to
# report a lock on, and the network may not resolve names yet. PartOf stops it
# again when the session ends and the panel goes out of reach.
[Unit]
Description=Thermaltake LCD dashboard
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# Where `cargo install` puts the binary. For the release binary, dropped in
# ~/.local/bin, use this line instead:
# ExecStart=%h/.local/bin/thermaltaked run
ExecStart=%h/.cargo/bin/thermaltaked run
# Log level: info, debug or trace, or per module (thermaltaked::player=debug).
# The lines carry journald priorities, so `journalctl --user -u thermaltaked
# -p warning` shows only what went wrong.
Environment=RUST_LOG=info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
